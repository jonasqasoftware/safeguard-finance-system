{
  "name": "safeguard-finance-system",
  "version": "2.0.0",
  "description": "Security-focused Quality Engineering lab for a transactional REST API.",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "test": "node --test tests/**/*.test.js",
    "test:ci": "node --experimental-test-coverage --test tests/**/*.test.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "validate": "npm run lint && npm run format:check && npm run test:ci"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "api-security",
    "negative-testing",
    "quality-engineering",
    "risk-based-testing",
    "owasp"
  ],
  "author": "Jonas Davila da Silva",
  "license": "MIT",
  "dependencies": {
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "xss": "^1.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "eslint": "^9.39.1",
    "prettier": "^3.7.4",
    "supertest": "^7.1.4"
  }
}
